{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://corporate-ops-cv.dev/schema/v1/resume.schema.json",
  "title": "CV Vận hành Doanh nghiệp",
  "description": "Schema JSON cho mẫu CV Corporate Operations — chỉnh dữ liệu tại src/data/resume.ts",
  "type": "object",
  "required": ["version", "locale", "personal", "summary", "experience", "skills", "education", "certifications", "projects", "languages"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "locale": { "type": "string", "enum": ["vi", "en", "ja"], "default": "vi" },
    "personal": {
      "type": "object",
      "required": ["fullName", "jobTitle", "contact"],
      "properties": {
        "fullName": { "type": "string", "minLength": 1, "description": "Họ và tên" },
        "jobTitle": { "type": "string", "description": "Chức danh" },
        "avatar": { "type": "string", "format": "uri-reference" },
        "contact": {
          "type": "object",
          "required": ["email", "phone", "location"],
          "properties": {
            "email": { "type": "string", "format": "email" },
            "phone": { "type": "string" },
            "linkedin": { "type": "string" },
            "github": { "type": "string" },
            "portfolio": { "type": "string" },
            "location": { "type": "string" }
          }
        }
      }
    },
    "summary": { "type": "string", "minLength": 50 },
    "experience": { "type": "array" },
    "skills": { "type": "object" },
    "education": { "type": "array" },
    "certifications": { "type": "array" },
    "projects": { "type": "array" },
    "languages": { "type": "array" }
  },
  "definitions": {
    "skillList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
