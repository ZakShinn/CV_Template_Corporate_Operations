{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://corporate-ops-cv.dev/schema/v1/resume.schema.json",
  "title": "Corporate Operations CV Resume",
  "description": "JSON resume schema for Corporate Operations CV template",
  "type": "object",
  "required": ["version", "locale", "personal", "summary", "experience", "skills", "education", "certifications", "projects", "languages"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "locale": { "type": "string", "enum": ["en", "vi", "ja"] },
    "personal": {
      "type": "object",
      "required": ["fullName", "jobTitle", "contact"],
      "properties": {
        "fullName": { "type": "string", "minLength": 1 },
        "jobTitle": { "type": "string" },
        "avatar": { "type": "string", "format": "uri-reference" },
        "contact": {
          "type": "object",
          "required": ["email", "phone", "location"],
          "properties": {
            "email": { "type": "string", "format": "email" },
            "phone": { "type": "string" },
            "linkedin": { "type": "string" },
            "github": { "type": "string" },
            "portfolio": { "type": "string" },
            "location": { "type": "string" }
          }
        }
      }
    },
    "summary": { "type": "string", "minLength": 50 },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "company", "position", "startDate", "endDate", "responsibilities", "achievements"],
        "properties": {
          "id": { "type": "string" },
          "company": { "type": "string" },
          "position": { "type": "string" },
          "location": { "type": "string" },
          "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "endDate": { "oneOf": [{ "type": "string", "const": "Present" }, { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }] },
          "responsibilities": { "type": "array", "items": { "type": "string" } },
          "achievements": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "skills": {
      "type": "object",
      "properties": {
        "technical": { "$ref": "#/definitions/skillList" },
        "soft": { "$ref": "#/definitions/skillList" },
        "tools": { "$ref": "#/definitions/skillList" },
        "infrastructure": { "$ref": "#/definitions/skillList" },
        "management": { "$ref": "#/definitions/skillList" }
      }
    },
    "education": { "type": "array" },
    "certifications": { "type": "array" },
    "projects": { "type": "array" },
    "languages": { "type": "array" }
  },
  "definitions": {
    "skillList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
